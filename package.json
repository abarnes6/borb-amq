{
  "name": "borb-amq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted anime music quiz with a buzzer gamemode",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w @borb/server",
    "dev:client": "npm run dev -w @borb/client",
    "build": "npm run build -w @borb/client",
    "start": "npm run start -w @borb/server",
    "ingest": "npm run ingest -w @borb/server --",
    "ingest:english": "npm run ingest:english -w @borb/server --",
    "typecheck": "npm run typecheck -w @borb/server && npm run typecheck -w @borb/client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
