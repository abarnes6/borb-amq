{
  "name": "@borb/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "ingest": "tsx --env-file-if-exists=../../.env src/ingest/run.ts",
    "ingest:english": "tsx --env-file-if-exists=../../.env src/ingest/english.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "test:e2e": "tsx --env-file-if-exists=../../.env test/e2e.ts",
    "test:mal": "tsx --env-file-if-exists=../../.env test/mal-e2e.ts",
    "test:reveal": "tsx --env-file-if-exists=../../.env test/reveal-e2e.ts"
  },
  "dependencies": {
    "@borb/shared": "*",
    "better-sqlite3": "^11.8.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
