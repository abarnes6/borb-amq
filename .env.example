PORT=8080
DB_PATH=./data/catalog.db
MEDIA_CACHE_DIR=./data/media-cache
MEDIA_CACHE_MAX_BYTES=8589934592

# auto = clip with ffmpeg when available, on = require ffmpeg, off = whole files
CLIP_MODE=auto

# sent to AnimeThemes in the User-Agent, set it to something that reaches you
INGEST_USER_AGENT=borb-amq/0.1 (+https://github.com/yourname/borb-amq)
INGEST_RPM=50
